<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base slate canvas -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E2E8F0" />
        </shape>
    </item>
    <!-- Ambient light orbs for frosted-glass depth -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33CBD5E1" />
            <size android:width="420dp" android:height="420dp" />
        </shape>
    </item>
    <item android:left="-120dp" android:top="-140dp">
        <shape android:shape="oval">
            <solid android:color="#3394A3B8" />
            <size android:width="360dp" android:height="360dp" />
        </shape>
    </item>
    <item android:right="-100dp" android:bottom="-120dp">
        <shape android:shape="oval">
            <solid android:color="#2FFFFFFF" />
            <size android:width="300dp" android:height="300dp" />
        </shape>
    </item>
</layer-list>
